#prisma 4.0
def package "luce-imap" {
    str owner = "dymokomi"
    str version = "0.1.0"
    str kind = "package"
    str language = "luce-base"
    str description = "An IMAP4rev1/IMAP4rev2 client in luce-base: the response grammar with literals, a session with capabilities and the selected mailbox's state, LOGIN and SASL PLAIN/XOAUTH2, LIST with special-use folders, STATUS, SELECT, UID FETCH/SEARCH/STORE/COPY/MOVE/EXPUNGE, APPEND and IDLE, mailbox names in modified UTF-7."
    str readme = "README.md"

    def export "imap" {
        str module = "luce_imap.imap"
    }

    def dependency "luce-tls" {
        str owner = "dymokomi"
        str version = "^0.1.4"
        str path = "../luce-tls"
    }

    def dependency "luce-std" {
        str owner = "dymokomi"
        str version = "^0.1.5"
        str path = "../luce-std"
    }
}
